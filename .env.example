# Copy to .env.local and fill in from Supabase: Project Settings → API Keys / Data API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Set to true once Google is enabled in Supabase (Authentication → Sign In / Providers).
VITE_GOOGLE_SIGN_IN=false
