{
  "name": "GameRoom",
  "type": "object",
  "properties": {
    "code": {
      "type": "string"
    },
    "room_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "waiting",
        "playing",
        "finished"
      ]
    },
    "host_id": {
      "type": "string"
    },
    "host_name": {
      "type": "string"
    },
    "player_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "player_names": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "max_players": {
      "type": "number"
    },
    "turn_name": {
      "type": "string"
    },
    "scores": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "winner_id": {
      "type": "string"
    },
    "winner_name": {
      "type": "string"
    },
    "started_at": {
      "type": "string"
    },
    "finished_at": {
      "type": "string"
    }
  },
  "required": [
    "code",
    "room_id",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.player_ids": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "data.player_ids": {
            "$in": [
              "{{user.id}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}